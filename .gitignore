# Пилот конвейера ассетов (этап 10): синтетическое дерево «сдачи фотографа»
# (scripts/make-pilot-delivery.mjs) и его выход. Это ТЕСТОВЫЙ материал,
# порождённый из чужих каталожных кадров, — в деплой он не едет никогда.
# Реальные кадры съёмки лягут в /public/frames/<артикул>/ и КОММИТЯТСЯ.
/.pilot-delivery/
/public/frames/_pilot/

# Рабочий выхлоп агентов-аудиторов: кропы и пересветы, нарезанные ИЗ ЧУЖИХ
# каталожных кадров (deco-*, hero-float — Safilo, Armani, Pierre Cardin).
# Материал доказательства, а не наш ассет: в git НИКОГДА.
/.fizik-tmp/
/.canon-test/

# ПЕРСОНАЛЬНЫЕ ДАННЫЕ — НИКОГДА В GIT.
# Сканы подписанных согласий на съёмку (docs/consent-photo.md) и разрешений
# правообладателей (docs/photo-permissions.md): паспортные данные, подписи,
# договоры. Оригиналы хранятся у владельца, репозиторий их не видит.
/docs/permissions/
