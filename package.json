{
  "name": "optimist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:catalog",
    "build": "next build",
    "postbuild": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-bundle.mjs && node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/weigh-route.mjs",
    "weigh": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/weigh-route.mjs",
    "weigh:self": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/weigh-route.mjs --self-check",
    "start": "next start",
    "lint": "next lint",
    "validate:catalog": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-catalog.mjs",
    "validate:catalog:self": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-catalog.mjs --self-check",
    "test:lib": "tsc -p tsconfig.test.json && node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/run-lib-tests.mjs",
    "check:attach": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-attach.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "lenis": "^1.3.23",
    "motion": "^12.40.0",
    "next": "14.2.35",
    "ogl": "^1.0.11",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
